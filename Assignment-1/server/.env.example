# Copy this file to .env and fill in your values
# Never commit the actual .env file to git!

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/ai_dj_studio

# JWT Secret - generate a long random value locally
JWT_SECRET=

# JWT expiry
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=30d

# Allowed browser client origin (required when deploying client and API separately)
CLIENT_URL=http://localhost:5173

# Server port
PORT=5000

# Local seed passwords (required only when the corresponding account is first created)
DEMO_HOST_PASSWORD=
DEMO_LISTENER_PASSWORD=
DEMO_ADMIN_PASSWORD=
